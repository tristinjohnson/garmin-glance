<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Training Dashboard</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<style>{{ css | safe }}</style>
</head>
<body>
{% if demo %}<div class="demo-banner">Demo data &mdash; synthetic values, not real metrics.</div>{% endif %}
<div class="wrap">
  <header class="top">
    <h1>Training Dashboard <span style="font-weight:400;color:var(--muted)">{{ data.athlete }}</span></h1>
    <div class="meta-right">
      <button id="themeBtn" class="theme-btn" type="button" aria-label="Toggle colour theme">Auto</button>
      <span class="stamp">refreshed {{ data.generated }} &nbsp;&middot;&nbsp; data through {{ data.today }}</span>
    </div>
  </header>

  <section class="card" id="countdown-card">
    <h2>Countdown</h2>
    <div class="countdown" id="countdown"></div>
  </section>

  <section class="card">
    <h2>Current fitness snapshot</h2>
    <div class="stats" id="snapshot"></div>
  </section>

  <section class="card">
    <h2>Training load &mdash; fitness / fatigue / form</h2>
    <div class="sub">CTL (fitness, 42-day load) &middot; ATL (fatigue, 7-day load) &middot; TSB = CTL &minus; ATL (form). Last {{ data.windows.load }} weeks.</div>
    <div class="chartbox"><canvas id="loadChart"></canvas></div>
  </section>

  <section class="card">
    <h2>Weekly volume &mdash; run / bike / swim</h2>
    <div class="sub">Distance per week, Monday&ndash;Sunday. Last {{ data.windows.mileage }} weeks. Multisport races counted via their individual legs.</div>
    <div class="grid3">
      <div><div class="chartbox sm"><canvas id="runMi"></canvas></div></div>
      <div><div class="chartbox sm"><canvas id="bikeMi"></canvas></div></div>
      <div><div class="chartbox sm"><canvas id="swimKm"></canvas></div></div>
    </div>
  </section>

  <section class="card">
    <h2>Weekly time &mdash; run / bike / swim</h2>
    <div class="sub">Hours per week, Monday&ndash;Sunday. Last {{ data.windows.mileage }} weeks.</div>
    <div class="grid3">
      <div><div class="chartbox sm"><canvas id="runHr"></canvas></div></div>
      <div><div class="chartbox sm"><canvas id="bikeHr"></canvas></div></div>
      <div><div class="chartbox sm"><canvas id="swimHr"></canvas></div></div>
    </div>
  </section>

  <section class="card">
    <h2>Recovery</h2>
    <div class="sub">Last {{ data.windows.recovery }} weeks. HRV shaded band = your balanced baseline range.</div>
    <div class="grid3">
      <div><div class="chartbox sm"><canvas id="hrvChart"></canvas></div></div>
      <div><div class="chartbox sm"><canvas id="rhrChart"></canvas></div></div>
      <div><div class="chartbox sm"><canvas id="sleepChart"></canvas></div></div>
    </div>
  </section>

  <section class="card">
    <h2>VO&#8322; max trend</h2>
    <div class="sub">Running VO&#8322; max estimate, last {{ data.windows.load }} weeks (days without a recompute carried forward).</div>
    <div class="chartbox"><canvas id="vo2Chart"></canvas></div>
  </section>

  <section class="card">
    <h2>Recent activities &mdash; last {{ data.windows.table }} days</h2>
    <div class="tbl-scroll"><table id="actTable">
      <thead><tr><th>Date</th><th>Sport</th><th>Workout</th><th>Distance</th><th>Pace / speed</th><th>Time</th><th>Avg HR</th></tr></thead>
      <tbody></tbody>
    </table></div>
  </section>

  <section class="card" id="pr-card">
    <h2>Personal records &amp; race predictions</h2>
    <div id="prBlock"></div>
  </section>

  <div class="foot">Generated by garmin-dashboard &mdash; re-run <code>uv run garmin-dashboard</code> to refresh.</div>
</div>

<script>const DATA = {{ data | tojson }};</script>
<script>{{ js | safe }}</script>
</body>
</html>
